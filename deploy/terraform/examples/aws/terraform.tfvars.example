region         = "eu-central-1"
domain         = "cloud.example.com"
# зона Route53, уже делегированная на AWS (рекомендуется); без неё — двухшаговый apply, см. deploy/README.md
hosted_zone_id = ""
admin_email    = "admin@example.com"
admin_password = "<придумайте-пароль>"
ssh_public_key = "ssh-ed25519 AAAA..."
admin_cidrs    = ["203.0.113.5/32"]
acme_email     = "ops@example.com"
# ключи AWS: export AWS_PROFILE=... (или AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
