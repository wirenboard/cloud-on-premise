#--------------------------------------------------------------------------
# Required — fill in. Secrets and passwords: `make generate-env` ------------
#--------------------------------------------------------------------------

# Public hostname of the cloud. Use the full host, including a subdomain if the cloud
# is deployed on one. Example: https://cloud.example.com -> ABSOLUTE_SERVER=cloud.example.com
ABSOLUTE_SERVER=my-domain-name.com

# Email sending (True/False). When False, no emails are sent; invitations and
# password resets are handled via the admin panel, and EMAIL_* below can be left unset.
EMAIL_ENABLED=True
# TLS on a submission port (587). For an SSL-only port (465) set EMAIL_USE_SSL instead.
EMAIL_USE_TLS=True
#EMAIL_USE_SSL=False
# How Grafana treats encryption when it sends alert mail through the same server.
# The default demands STARTTLS, which fits port 587. On an SSL-only port (465) or a
# relay that takes mail unencrypted set NoStartTLS, or the alerts go nowhere while
# the cloud's own mail keeps working.
#EMAIL_STARTTLS_POLICY=MandatoryStartTLS
EMAIL_HOST_USER=mymail@mail.com
EMAIL_HOST_PASSWORD=password
EMAIL_HOST=smtp.mail.com
EMAIL_PORT=587
EMAIL_NOTIFICATIONS_FROM=mymail@mail.com

# The email is also the login.
ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD=password

# This account signs in to the metrics dashboards at metrics.<your domain>.
# Both go into a URL: no / ? # [ ] and no %-escapes.
GRAFANA_ADMIN_USER=grafana_admin
GRAFANA_ADMIN_PASSWORD=grafana_password

TUNNEL_DASHBOARD_USER=tunnel_admin
TUNNEL_DASHBOARD_PASSWORD=tunnel_password
TUNNEL_DASHBOARD_PORT=7501
TUNNEL_PORT=7107

# User and password go into a URL: no / ? # [ ] and no %-escapes.
POSTGRES_DB=db_name
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

#--------------------------------------------------------------------------
# Optional ----------------------------------------------------------------
#--------------------------------------------------------------------------

# Override the organization invitation email. Leave commented to keep the built-in
# RU/EN translation, which names the organization the person is invited to — a custom
# text replaces it entirely and cannot show the name. Use \n in INVITE_EMAIL_BODY for
# line breaks; the invite link is always appended at the end of the body.
#INVITE_EMAIL_SUBJECT="You have been invited to a Wiren Board Cloud organization"
#INVITE_EMAIL_BODY="Hello!\nYou have been invited to our organization.\nClick the link to register:"

# Credentials of the bundled S3 storage, where diagnostic archives and media are kept.
#MINIO_ROOT_USER=minio_admin
#MINIO_ROOT_PASSWORD=minio_password

# How long controller metrics are kept. Set it before the first launch: on a running
# installation the value can be lowered at any time, but raising it has no full effect —
# the database keeps deleting by the period it was created with (see README).
#METRICS_RETENTION_DAYS=30

# Metrics store logins. The passwords are not here: `make generate-env` writes random
# ones into .env on the first run. The metrics store bakes them in when it is created,
# so changing them afterwards only breaks the connection — it does not rotate anything.
#TIMESCALE_USER=timescale
#TIMESCALE_DB=metrics
#TELEGRAF_TIMESCALE_USER=telegraf
#GRAFANA_TIMESCALE_USER=grafana

# Background task parallelism, sized for up to 100 controllers. Lower it on a small
# installation to save memory, raise it for many organizations (~85 MB per unit).
#WORKER_CONCURRENCY=4
#METRICS_WORKER_CONCURRENCY=3
#GRAFANA_WORKER_CONCURRENCY=3
#EMAIL_WORKER_CONCURRENCY=2

# Session geolocation: downloads the DB-IP City Lite database on `make run`
# (~62 MB over the network, ~124 MB unpacked in ./geoip).
#GEOIP_ENABLED=True

#DOCKER_NET_NAME=my-docker-network

#TLS_CERTS_PATH="path/to/my/certs/"

#TRAEFIK_EXTERNAL_PORT="127.0.0.1:8443"

# ----- Branding -----
# Override the product name, links, and color shown in the web UI and web console.
# Leave commented to keep the Wiren Board defaults.

# Product name: UI texts and the browser tab title.
#SERVICE_NAME="My Cloud"

# Primary button color as a hex value (e.g. #e2500a).
#PRIMARY_COLOR="#e2500a"

# Your service status page. Not set or empty — the status link is not shown.
#SERVICE_STATUS_URL="https://status.example.com/"

# Documentation link. Not set — Wiren Board wiki; empty ("") — the docs link is not shown.
#SERVICE_DOCS_URL="https://docs.example.com/"

# Page the book icons in the web UI point into. Not set — Wiren Board wiki; empty ("") — no icons.
#SERVICE_DOCS_PAGE_URL="https://docs.example.com/cloud"

# Company site link in the web UI footer. Not set — wirenboard.com; empty ("") — the link
# is not shown. If only one label is set, it is used for both languages.
#FOOTER_SITE_URL="https://example.com/"
#FOOTER_SITE_LABEL_RU="Сайт компании"
#FOOTER_SITE_LABEL_EN="Company website"
