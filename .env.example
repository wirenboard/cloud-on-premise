## Public hostname of the cloud. Use the full host, including a subdomain if the cloud
# is deployed on one. Example: https://cloud.example.com -> ABSOLUTE_SERVER=cloud.example.com
ABSOLUTE_SERVER=my-domain-name.com

EMAIL_PROTOCOL=smtp+tls
EMAIL_LOGIN=mymail@mail.com
EMAIL_PASSWORD=password
EMAIL_SERVER=smtp.mail.com
EMAIL_PORT=587
EMAIL_NOTIFICATIONS_FROM=mymail@mail.com

ADMIN_EMAIL=admin@mail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

TUNNEL_DASHBOARD_USER=tunnel_admin
TUNNEL_DASHBOARD_PASSWORD=tunnel_password
TUNNEL_DASHBOARD_PORT=7501
TUNNEL_PORT=7107

# Application database (PostgreSQL, accessed through the pgcat pooler).
POSTGRES_DB=db_name
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

# Metrics database (TimescaleDB). Stores controller MQTT metrics.
TIMESCALE_DB=metrics
TIMESCALE_USER=timescale
TIMESCALE_PASSWORD=timescale_password
# Telegraf writes ingested metrics into TimescaleDB with this role.
TELEGRAF_TIMESCALE_USER=telegraf
TELEGRAF_TIMESCALE_PASSWORD=telegraf_password

# Clients Grafana (per-organisation dashboards) — its own DB on the app PostgreSQL.
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD=grafana_db_password
# Grafana admin account.
GRAFANA_ADMIN_USER=grafana_admin
GRAFANA_ADMIN_PASSWORD=grafana_password

#--------------------------------------------------------------------------
# Optional ----------------------------------------------------------------
#--------------------------------------------------------------------------

# Override the organization invitation email. Leave commented to keep the built-in
# RU/EN translation. Use \n in INVITE_EMAIL_BODY for line breaks; the invite link
# is always appended at the end of the body.
#INVITE_EMAIL_SUBJECT="You have been invited to a Wiren Board Cloud organization"
#INVITE_EMAIL_BODY="Hello!\nYou have been invited to our organization.\nClick the link to register:"

# Token the backend uses to talk to the internal Wiren Board license service.
# Leave empty for a self-contained on-premise deployment without licensing.
#INTERNAL_LICENSE_SERVICE_TOKEN=

# Metrics ingest rate limiting (Traefik + backend stay in sync).
#METRICS_COLLECTOR_RATELIMIT_AVERAGE=6      # requests per period from one controller
#METRICS_COLLECTOR_RATELIMIT_PERIOD_S=60    # rate-limit window (seconds)
#METRICS_COLLECTOR_MAX_REQUEST_BYTES=204800 # max body size per ingest request (~200 KB)

# TimescaleDB retention / reader limits (defaults match upstream).
#TIMESCALE_DEFAULT_RETENTION_DAYS=14
#TIMESCALE_VIEWS_READER_STATEMENT_TIMEOUT=15s
#TIMESCALE_VIEWS_READER_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=30s
#TIMESCALE_VIEWS_READER_LOCK_TIMEOUT=5s
#TIMESCALE_VIEWS_READER_WORK_MEM_MB=32
#TIMESCALE_MQTT_METRICS_MEASUREMENT_NAME=mqtt_metrics

# Celery queue names (one worker per queue: worker / worker-metrics / worker-grafana / worker-email).
#CELERY_DEFAULT_QUEUE=wbc_default
#CELERY_METRICS_QUEUE=wbc_metrics
#CELERY_GRAFANA_QUEUE=wbc_grafana
#CELERY_EMAIL_QUEUE=wbc_email

# External Prometheus / VictoriaMetrics long-term metrics store.
# Leave empty (default) to disable; on-premise normally relies on TimescaleDB only.
#PROM_LABEL_PROXY_ADDRESS=
#PROM_SELECT_ADDRESS=
#PROM_INSERT_ADDRESS=
#PROM_TOKEN=

# Nightly PostgreSQL backup into the bundled MinIO (S3) bucket.
#POSTGRES_BACKUP_SCHEDULE=30 23 * * *
#POSTGRES_BACKUP_KEEP_DAYS=3
#POSTGRES_BACKUP_BUCKET=postgres-backup
#POSTGRES_BACKUP_PREFIX=on-premise

#MINIO_ROOT_USER=minio_admin
#MINIO_ROOT_PASSWORD=minio_password

#DOCKER_NET_NAME=my-docker-network

#TLS_CERTS_PATH="path/to/my/certs/"

#TRAEFIK_EXTERNAL_PORT="127.0.0.1:8443"
